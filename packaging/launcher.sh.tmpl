#!/bin/zsh
# Generated by `demat install-app` (packaging/make_app.sh, ADR 0017). This is
# the .app's CFBundleExecutable. It hands over to the Homebrew-installed
# `demat run`, which stays in the foreground so the .app remains alive in the
# Dock and quitting it stops the server.
export DEMAT_HOME=${DEMAT_HOME:-@@HOME@@}
# A GUI-launched process does not inherit a shell PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
exec "@@DEMAT_BIN@@" run --log
